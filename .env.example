# Copy to .env and fill in your key: cp .env.example .env
# Inspect AI loads .env automatically; .env is git-ignored.

# UCL ARC Condenser (LiteLLM proxy, OpenAI-compatible).
# Use with: --model openai-api/ucl_condenser/<model-name>
UCL_CONDENSER_BASE_URL=https://litellm.arc-llm.condenser.arc.ucl.ac.uk/v1
UCL_CONDENSER_API_KEY=sk-xxx
